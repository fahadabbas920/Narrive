# Database — used by docker-compose to create the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=storybook

# App settings
SECRET_KEY=change-me-run-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/storybook
BACKEND_CORS_ORIGINS=http://localhost:3000
